# App
NODE_ENV=development
APP_URL=http://localhost:3000
OWNER_EMAIL=oleh@example.com
DEFAULT_WORKSPACE_NAME=Oleh workspace
DEFAULT_WORKSPACE_SLUG=personal

# Database (local Docker example)
DATABASE_URL=postgresql://zvedeno:zvedeno@localhost:5432/zvedeno

# Encryption — 32 random bytes encoded as 64 hex characters or base64
# setup-local.sh generates this automatically when it is empty.
TOKEN_ENCRYPTION_KEY=

# Meta Marketing API
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v24.0
META_REDIRECT_URI=http://localhost:3000/api/integrations/meta/callback

# Optional for an owner-controlled Business Portfolio.
# Use a System User token generated with ads_read and business_management.
# When Meta offers the "Never" expiration option, this avoids regular OAuth reconnects.
META_SYSTEM_USER_TOKEN=

# Google OAuth / Sheets / Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Optional object storage for stable creative thumbnails / media archive
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Worker / scheduled sync
SYNC_LOOKBACK_DAYS=28
SYNC_INTERVAL_MINUTES=15
SYNC_CONCURRENCY=2
# Same random secret must be stored in Vercel and GitHub Actions repository secrets.
CRON_SECRET=
